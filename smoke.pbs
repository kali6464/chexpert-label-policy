#!/bin/bash
#PBS -q gpus
#PBS -N chexpert_smoke
#PBS -l select=1:mem=64gb:ncpus=8:ngpus=1:glist=a100
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -W group_list=x-ccast-prj-siludwig

cd ${PBS_O_WORKDIR}
module load cuda/12.3
module load cudnn/8.9
source ~/anaconda3/bin/activate pytorch-gym

python -u train.py --config config.yaml max_steps=100 eval_every=50 log_every=10 run_name=smoke
