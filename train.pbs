#!/bin/bash
#PBS -q gpus
#PBS -N chexpert_run
## 64gb is plenty once images are pre-resized; raise it if your jobs need more
#PBS -l select=1:mem=64gb:ncpus=8:ngpus=1:glist=a100
#PBS -l walltime=12:00:00
#PBS -W group_list=x-ccast-prj-siludwig

# Submitted by submit_grid.sh, which passes BACKBONE, POLICY, LR, WD and SEED.
cd ${PBS_O_WORKDIR}
module load cuda/12.3
module load cudnn/8.9
source ~/anaconda3/bin/activate pytorch-gym

python -u train.py --config config.yaml \
    backbone=${BACKBONE} uncertainty_policy=${POLICY} \
    lr=${LR} weight_decay=${WD} seed=${SEED}
